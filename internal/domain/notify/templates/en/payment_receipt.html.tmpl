<!doctype html>
<html lang="en">
<body style="font-family: sans-serif; line-height: 1.5;">
<p>Dear {{with v . "customer_name"}}{{.}}{{else}}customer{{end}},</p>
<p>we have received your payment. Thank you.</p>
<table>
{{with v . "payment_number"}}<tr><td>Payment</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "amount"}}<tr><td>Amount</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "received_on"}}<tr><td>Date</td><td>{{.}}</td></tr>{{end}}
{{with v . "method"}}<tr><td>Method</td><td>{{.}}</td></tr>{{end}}
</table>
<p style="color: #666;">Courtesy receipt, not valid for tax purposes (non valido ai fini fiscali).</p>
<p style="color: #666;">{{v . "marina_name"}}</p>
</body>
</html>
