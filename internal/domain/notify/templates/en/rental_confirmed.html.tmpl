<!doctype html>
<html lang="en">
<body style="font-family: sans-serif; line-height: 1.5;">
<p>Dear {{with v . "customer_name"}}{{.}}{{else}}customer{{end}},</p>
<p>your rental is confirmed.</p>
<table>
{{with v . "reference"}}<tr><td>Reference</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "unit"}}<tr><td>Boat</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "starts_on"}}<tr><td>Pick-up</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "ends_on"}}<tr><td>Return</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "amount"}}<tr><td>Amount</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "qr"}}<tr><td>Code to show at the pier</td><td><strong>{{.}}</strong></td></tr>{{end}}
</table>
<p>Please bring an identity document and, when required, your boating licence.</p>
<p style="color: #666;">{{v . "marina_name"}}</p>
</body>
</html>
