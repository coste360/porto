<!doctype html>
<html lang="en">
<body style="font-family: sans-serif; line-height: 1.5;">
<p>Dear {{with v . "customer_name"}}{{.}}{{else}}customer{{end}},</p>
<p>despite our previous reminder, the amounts below are still unpaid. Please pay as soon as possible.</p>
{{with v . "charges"}}<pre style="font-family: inherit;">{{.}}</pre>{{end}}
<table>
{{with v . "amount"}}<tr><td>Amount</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "due_on"}}<tr><td>Due date</td><td><strong>{{.}}</strong></td></tr>{{end}}
</table>
{{with v . "iban"}}<p>You can pay by bank transfer:</p>
<table><tr><td>IBAN</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "bank_holder"}}<tr><td>Account holder</td><td>{{.}}</td></tr>{{end}}
{{with v . "bank"}}<tr><td>Bank</td><td>{{.}}</td></tr>{{end}}
{{with v . "reference"}}<tr><td>Reference</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{if v . "iban"}}</table>{{end}}
{{with v . "link"}}<p><a href="{{.}}">Pay or see the details</a></p>{{end}}
{{with v . "expires_at"}}<p style="color: #666;">Link valid until {{.}}</p>{{end}}
<p style="color: #666;">{{v . "marina_name"}}</p>
</body>
</html>
