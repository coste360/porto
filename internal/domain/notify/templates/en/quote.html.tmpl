<!doctype html>
<html lang="en">
<body style="font-family: sans-serif; line-height: 1.5;">
<p>Dear {{with v . "customer_name"}}{{.}}{{else}}customer{{end}},</p>
<p>please find the quote you asked for attached.</p>
<table>
{{with v . "quote_code"}}<tr><td>Quote</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "starts_on"}}<tr><td>From</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "ends_on"}}<tr><td>To</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "amount"}}<tr><td>Total</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "valid_until"}}<tr><td>Valid until</td><td><strong>{{.}}</strong></td></tr>{{end}}
</table>
{{with v . "link"}}<p><a href="{{.}}">View and accept the quote</a></p>{{end}}
<p style="color: #666;">{{v . "marina_name"}}</p>
</body>
</html>
