<!doctype html>
<html lang="it">
<body style="font-family: sans-serif; line-height: 1.5;">
<p>Gentile {{with v . "customer_name"}}{{.}}{{else}}cliente{{end}},</p>
<p>come previsto dalla clausola di rinnovo tacito, il tuo contratto è stato rinnovato.</p>
<table>
{{with v . "contract_code"}}<tr><td>Nuovo contratto</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "starts_on"}}<tr><td>Dal</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "ends_on"}}<tr><td>Al</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "new_total"}}<tr><td>Importo</td><td><strong>{{.}}</strong></td></tr>{{end}}
</table>
<p style="color: #666;">{{v . "marina_name"}}</p>
</body>
</html>
