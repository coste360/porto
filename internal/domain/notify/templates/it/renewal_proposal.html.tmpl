<!doctype html>
<html lang="it">
<body style="font-family: sans-serif; line-height: 1.5;">
<p>Gentile {{with v . "customer_name"}}{{.}}{{else}}cliente{{end}},</p>
<p>ti proponiamo il rinnovo del tuo contratto. Puoi accettarlo o rifiutarlo online.</p>
<table>
{{with v . "contract_code"}}<tr><td>Contratto attuale</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "starts_on"}}<tr><td>Nuovo periodo dal</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "ends_on"}}<tr><td>Al</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "old_total"}}<tr><td>Importo attuale</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "new_total"}}<tr><td>Nuovo importo</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "deadline_on"}}<tr><td>Rispondi entro il</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "message"}}<tr><td>Messaggio</td><td><strong>{{.}}</strong></td></tr>{{end}}
</table>
{{with v . "link"}}<p><a href="{{.}}">Vedi la proposta</a></p>{{end}}
<p style="color: #666;">{{v . "marina_name"}}</p>
</body>
</html>
