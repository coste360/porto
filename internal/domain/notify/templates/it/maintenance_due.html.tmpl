<!doctype html>
<html lang="it">
<body style="font-family: sans-serif; line-height: 1.5;">
<p>Buongiorno,</p>
<p>un intervento di manutenzione programmata è in scadenza. Apri l'elenco delle manutenzioni per pianificarlo.</p>
<table>
{{with v . "task_title"}}<tr><td>Intervento</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "element_code"}}<tr><td>Elemento</td><td><strong>{{.}}</strong></td></tr>{{end}}
{{with v . "due_on"}}<tr><td>Scadenza</td><td><strong>{{.}}</strong></td></tr>{{end}}
</table>
{{with v . "link"}}<p><a href="{{.}}">Apri le manutenzioni</a></p>{{end}}
<p style="color: #666;">{{v . "marina_name"}}</p>
</body>
</html>
