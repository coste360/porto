#include <winver.h>

1 ICON "porto.ico"
1 24 "porto.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041004B0"
    BEGIN
      VALUE "CompanyName", "Coste360 SRL"
      VALUE "FileDescription", "Porto"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "porto-desktop"
      VALUE "OriginalFilename", "porto-desktop.exe"
      VALUE "ProductName", "Porto"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0410, 1200
  END
END
