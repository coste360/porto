# Environment of the Porto public demo (deploy/demo/docker-compose.yml). Copy to deploy/demo/.env.
# Public https address of the demo (behind your TLS reverse proxy).
PORTO_BASE_URL=https://demo.example.org
# Required: openssl rand -base64 32. Losing it only loses the demo data, which is reset every night anyway.
PORTO_SECRET_KEY=
# Password of every demo user ("porto seed demo"): it is public, shown on the demo landing page. At least 12
# characters. Never reuse a real password here.
PORTO_ADMIN_PASSWORD=
# The reverse proxy in front of the demo (Caddy, nginx, Traefik) on the Docker host.
PORTO_TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12
# Image tag: follow the latest stable release, or pin one (e.g. 1.2).
PORTO_VERSION=latest
PORTO_LOG_LEVEL=info
