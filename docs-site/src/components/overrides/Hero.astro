---
/**
 * Hero of splash pages. A page with the `home` frontmatter (the home in each
 * locale) gets the product hero: the horizontal Porto logo (outlined copies of
 * assets/brand/porto, ADR 0007), the title, one line of key facts, the
 * tagline, the actions, a link for technical readers and the operational view
 * of the demo marina (light or dark screenshot following the theme) with the
 * public booking page on a phone. Other splash pages (404) keep Starlight's
 * default hero.
 */
import Default from '@astrojs/starlight/components/Hero.astro';
import { Icon, LinkButton } from '@astrojs/starlight/components';
import Screenshot from '../Screenshot.astro';

const { data } = Astro.locals.starlightRoute.entry;
const home = data.home;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const baseDir = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logo = (file: string) => `${baseDir}brand/porto/${file}`;
/** Root-relative links of the frontmatter get the base path; relative ones are left alone. */
const withBase = (href: string) => (href.startsWith('/') && !href.startsWith('//') ? baseDir + href.slice(1) : href);
---

{
  home ? (
    <div class="porto-hero">
      <div class="copy">
        <img src={logo('porto_logo_horizontal_primary.svg')} width="655" height="202" alt="Porto" class="logo dark:sl-hidden" />
        <img
          src={logo('porto_logo_horizontal_inverted_2color.svg')}
          width="655"
          height="202"
          alt="Porto"
          class="logo light:sl-hidden"
        />
        <h1 id="_top" data-page-title set:html={title} />
        <p class="facts">{home.facts}</p>
        {tagline && <p class="tagline" set:html={tagline} />}
        {actions.length > 0 && (
          <div class="actions">
            {actions.map(({ icon, link, text, variant }) => (
              <LinkButton href={link} variant={variant} icon={icon?.name}>
                {text}
              </LinkButton>
            ))}
          </div>
        )}
        <a class="tech" href={withBase(home.techLink.link)}>
          <Icon name="setting" size="1rem" />
          <span>{home.techLink.text}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="visual">
        <div class="desktop">
          <Screenshot name={home.shot.light} dark={home.shot.dark} alt={home.shot.alt} eager sizes="(max-width: 72rem) 100vw, 72rem" />
        </div>
        {home.phone && (
          <div class="phone">
            <Screenshot name={home.phone.name} alt={home.phone.alt} frame="phone" sizes="12rem" />
          </div>
        )}
      </div>
    </div>
  ) : (
    <Default />
  )
}

<style>
  .porto-hero {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(1rem, 4vw, 2.5rem) 1rem;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    text-align: center;
  }
  .logo {
    width: clamp(12rem, 9rem + 10vw, 17rem);
    height: auto;
  }
  h1 {
    margin: 0;
    max-width: 22ch;
    color: var(--sl-color-white);
    font-size: clamp(2rem, 1.1rem + 4vw, 3.6rem);
    font-weight: 700;
    line-height: 1.1;
    text-wrap: balance;
  }
  .facts {
    margin: 0;
    color: var(--sl-color-text-accent);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    font-weight: 600;
    text-wrap: balance;
  }
  .tagline {
    margin: 0;
    max-width: 44rem;
    color: var(--sl-color-gray-2);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.25rem);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .tech {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .tech:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
  .visual {
    position: relative;
  }
  .desktop :global(.porto-shot),
  .phone :global(.porto-shot) {
    margin: 0;
  }
  .phone {
    display: none;
  }
  @media (min-width: 50rem) {
    .desktop {
      margin-inline-end: 6rem;
    }
    .phone {
      display: block;
      position: absolute;
      right: 0;
      bottom: -1.5rem;
      width: 11.5rem;
    }
  }
  @media (max-width: 30rem) {
    .actions {
      flex-direction: column;
      align-self: stretch;
    }
  }
</style>
