---
/**
 * <Screenshot name="harbour-map-piers" alt="…" /> — a product screenshot from
 * src/assets/screenshots/<name>.webp (converted from docs/screenshots/ by
 * scripts/screenshots.mjs), optimised by Astro, framed as a browser window or
 * a phone. With `dark="…"` the second image is shown in the dark theme. The
 * image links to the full-size file. An unknown name fails the build.
 */
import { Image } from 'astro:assets';

interface Props {
  name: string;
  dark?: string;
  alt: string;
  caption?: string;
  frame?: 'browser' | 'phone';
  eager?: boolean;
  sizes?: string;
}

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.webp', { eager: true });
const find = (name: string): ImageMetadata => {
  const shot = shots[`../assets/screenshots/${name}.webp`];
  if (!shot) {
    const known = Object.keys(shots).map((k) => k.replace(/^.*\/(.*)\.webp$/, '$1'));
    throw new Error(`<Screenshot>: unknown screenshot "${name}". Known: ${known.join(', ')}`);
  }
  return shot.default;
};

const { name, dark, alt, caption, frame = name.startsWith('phone-') ? 'phone' : 'browser', eager = false } =
  Astro.props;
const sizes = Astro.props.sizes ?? (frame === 'phone' ? '18rem' : '(max-width: 50rem) 100vw, 48rem');
const light = find(name);
const night = dark ? find(dark) : undefined;
const loading = eager ? 'eager' : 'lazy';
---

<figure class:list={['porto-shot', `porto-shot-${frame}`]}>
  <div class="frame">
    {frame === 'browser' && <div class="bar" aria-hidden="true"><span /><span /><span /></div>}
    <a href={light.src} class:list={[night && 'only-light']} title={Astro.locals.t('porto.screenshot.zoom')}>
      <Image src={light} {alt} {sizes} {loading} widths={[480, 800, 1200, light.width]} />
    </a>
    {
      night && (
        <a href={night.src} class="only-dark" title={Astro.locals.t('porto.screenshot.zoom')}>
          <Image src={night} {alt} {sizes} {loading} widths={[480, 800, 1200, night.width]} />
        </a>
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .porto-shot {
    margin-block: 1.5rem;
  }
  .frame {
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: calc(var(--radius) + 2px);
    background: var(--card);
    box-shadow: 0 18px 40px -24px color-mix(in oklab, var(--brand-navy) 45%, transparent);
  }
  .porto-shot-phone {
    max-width: 18rem;
    margin-inline: auto;
  }
  .porto-shot-phone .frame {
    border-width: 6px;
    border-color: var(--sl-color-gray-5);
    border-radius: 1.75rem;
  }
  .bar {
    display: flex;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    background: var(--muted);
  }
  .bar span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--sl-color-gray-4);
  }
  .frame a {
    display: block;
  }
  /* Light or dark variant following Starlight's theme. */
  :global(:root[data-theme='dark']) .frame a.only-light,
  :global(:root:not([data-theme='dark'])) .frame a.only-dark {
    display: none;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
</style>
