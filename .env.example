# Porto configuration (spec 31.4). Copy to deploy/.env for the compose files in deploy/, or export the variables.
# Every value below is the default unless marked "required"; commented lines differ between binary and image
# (the image sets PORTO_DATA_DIR=/data and PORTO_ADDR=:8080). Never commit the real .env.

# --- Server -----------------------------------------------------------------------------------------------------
# Listen address (host:port).
#PORTO_ADDR=:8080
# Public URL used in links and cookies. Must be https unless PORTO_DEV=true or the host is localhost.
PORTO_BASE_URL=http://localhost:8080
# Data directory: SQLite file porto.db, dev secret.key, autocert cache certs/. The image uses /data.
#PORTO_DATA_DIR=./data
# Comma-separated hostnames: when set, serve listens on :443 with Let's Encrypt (autocert) and :80 for redirect/ACME.
PORTO_TLS_AUTOCERT_DOMAINS=
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are trusted.
PORTO_TRUSTED_PROXIES=

# --- Database ---------------------------------------------------------------------------------------------------
# Empty: SQLite in PORTO_DATA_DIR. Otherwise postgres:// or postgresql:// (URL-encode special characters).
DATABASE_URL=
# Used only by deploy/docker-compose.postgres.yml (required there).
POSTGRES_PASSWORD=
# Run pending migrations on serve. When false, serve refuses to start with pending migrations (porto migrate up).
PORTO_AUTO_MIGRATE=true

# --- Secrets ----------------------------------------------------------------------------------------------------
# Required (except with PORTO_DEV=true, where one is generated into DATA_DIR/secret.key).
# Comma-separated base64 32-byte keys, the first is active; append the old key when rotating.
# Generate with: openssl rand -base64 32
PORTO_SECRET_KEY=

# --- Mail -------------------------------------------------------------------------------------------------------
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465. Empty: files in PORTO_MAIL_DIR, else log only.
PORTO_SMTP_URL=
# Sender address; with SMTP outside dev mode it must use a real (non-localhost) domain.
PORTO_MAIL_FROM=Porto <noreply@localhost>
# Directory for .eml files (development and tests).
PORTO_MAIL_DIR=

# --- Security and policy ----------------------------------------------------------------------------------------
# Require TOTP for the owner and accounting roles.
PORTO_REQUIRE_TOTP_FOR_OWNERS=false
# Requests per minute per client network on /api/public/v1 (1..10000).
PORTO_PUBLIC_READS_PER_MINUTE=120
# Development and tests only: allow webhooks to private addresses and plain http.
PORTO_WEBHOOKS_ALLOW_PRIVATE=false

# --- Logging ----------------------------------------------------------------------------------------------------
# debug, info, warn, error
PORTO_LOG_LEVEL=info
# json or text (text by default when PORTO_DEV=true)
#PORTO_LOG_FORMAT=json

# --- Domain settings parsed now, used by later milestones -------------------------------------------------------
# Duration of an online booking hold, 1m..60m (from M3).
PORTO_HOLD_TTL=10m
# Retention of raw sensor readings, 1d..3650d (from M12).
PORTO_SENSOR_RAW_RETENTION=30d
# No telemetry exists: must stay false.
PORTO_TELEMETRY=false

# --- First owner and demo ---------------------------------------------------------------------------------------
# All three (with PORTO_ADMIN_PASSWORD) or none: serve creates the first owner when there are no users.
PORTO_BOOTSTRAP_OWNER_EMAIL=
PORTO_BOOTSTRAP_OWNER_NAME=
PORTO_BOOTSTRAP_OWNER_ORG=
# Password for "porto admin create", the bootstrap owner and "porto seed demo". Never logged.
PORTO_ADMIN_PASSWORD=
# Demo device pairing: user email and marina slug, both or neither.
PORTO_DEMO_PAIRING_USER=
PORTO_DEMO_PAIRING_MARINA=

# --- Development ------------------------------------------------------------------------------------------------
# Generated secret, non-Secure cookies over http, text logs. Never in production.
PORTO_DEV=false

# --- Desktop edition (porto-desktop only, M6a; see docs/desktop-build.md) ----------------------------------------
# The launcher sets PORTO_ADDR, PORTO_BASE_URL (http://127.0.0.1:<port>), PORTO_DATA_DIR (per-user folder unless
# set), PORTO_SECRET_KEY (OS keychain unless set), PORTO_AUTO_MIGRATE and PORTO_MAIL_DIR itself; SQLite only.
# Daily check for a newer version (notify only, never installs). false = no request at all.
#PORTO_UPDATE_CHECK=true
# Loopback port of the app window (default: remembered, else picked by the OS).
#PORTO_DESKTOP_PORT=
# Local-network HTTPS port (default 8443).
#PORTO_DESKTOP_LAN_PORT=8443
# Secret key store: auto (OS keychain, file fallback) or file (<data>/secret.key, CI and e2e).
#PORTO_DESKTOP_KEYRING=auto
# Dev only (PORTO_DEV=true, refused otherwise): version-check URL, LAN listener on 127.0.0.1, first-run URL file.
#PORTO_UPDATE_URL=
#PORTO_DESKTOP_LAN_LOOPBACK=false
#PORTO_DESKTOP_FIRST_RUN_FILE=false

# --- Docker compose only ----------------------------------------------------------------------------------------
# Image tag and published host port.
PORTO_VERSION=latest
PORTO_PUBLISH_PORT=8080
